{
  "name": "agrocredit-lab", "version": "1.0.0", "private": true,
  "description": "Projeto pessoal com emulação local de serviços AWS",
  "license": "MIT", "engines": {"node": ">=22.12 <25"},
  "scripts": {
    "setup": "node scripts/control.mjs setup",
    "infra:up": "node scripts/control.mjs infra-up",
    "infra:down": "node scripts/control.mjs infra-down",
    "db:migrate": "node scripts/control.mjs migrate-only", "db:seed": "node dist/seed.js",
    "build": "tsc -p tsconfig.json && tsc -p web/tsconfig.json && vite build --config web/vite.config.mjs --configLoader native",
    "start": "node scripts/control.mjs start", "stop": "node scripts/control.mjs stop",
    "api": "node dist/main.js", "worker": "node dist/worker.js",
    "web": "vite --config web/vite.config.mjs --configLoader native --host 127.0.0.1",
    "test": "jest --runInBand", "test:integration": "node scripts/control.mjs test",
    "test:e2e": "playwright test", "check": "npm run build && npm test"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7", "@nestjs/core": "11.2.7", "@nestjs/platform-express": "11.2.7",
    "@prisma/client": "6.19.0", "@aws-sdk/client-s3": "3.1073.0", "@aws-sdk/s3-request-presigner": "3.1073.0",
    "bcryptjs": "3.0.3", "class-transformer": "0.5.1", "class-validator": "0.14.4",
    "dotenv": "16.6.1", "fast-xml-parser": "5.7.3", "helmet": "8.3.0", "multer": "2.4.0",
    "react": "19.3.0", "react-dom": "19.3.0", "reflect-metadata": "0.2.2", "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1", "@types/express": "5.0.6", "@types/jest": "29.5.14", "@types/node": "24.19.1",
    "@types/react": "19.3.0", "@types/react-dom": "19.3.0", "@types/supertest": "6.0.3",
    "@vitejs/plugin-react": "5.2.0", "jest": "29.7.0", "prisma": "6.19.0", "supertest": "7.3.1",
    "ts-jest": "29.4.14", "typescript": "5.9.3", "vite": "7.3.7"
  },
  "prisma": {"seed": "node dist/seed.js"}
}
