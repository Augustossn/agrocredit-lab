generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  APPLICANT
  ANALYST
}
enum Status {
  DRAFT
  SUBMITTED
  ANALYZING
  APPROVED
  REJECTED
}
model User {
  id String @id @default(uuid())
  email String @unique
  name String
  passwordHash String
  role Role
  sessions Session[]
  producers Producer[]
}
model Session {
  id String @id
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  expiresAt DateTime
}
model Producer {
  id String @id @default(uuid())
  name String
  syntheticCode String @unique
  ownerId String
  owner User @relation(fields:[ownerId],references:[id])
  properties Property[]
}
model Property {
  id String @id @default(uuid())
  name String
  city String
  hectares Decimal @db.Decimal(12,2)
  producerId String
  producer Producer @relation(fields:[producerId],references:[id])
  requests CreditRequest[]
}
model CreditRequest {
  id String @id @default(uuid())
  propertyId String
  property Property @relation(fields:[propertyId],references:[id])
  amount Decimal @db.Decimal(16,2)
  purpose String
  months Int
  revenue Decimal @db.Decimal(16,2)
  costs Decimal @db.Decimal(16,2)
  debt Decimal @db.Decimal(16,2)
  status Status @default(DRAFT)
  recommendation Json?
  justification String?
  version Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  audits Audit[]
  documents Document[]
  events AnalysisEvent[]
  @@index([status,createdAt])
}
model Audit {
  id String @id @default(uuid())
  requestId String
  request CreditRequest @relation(fields:[requestId],references:[id])
  actorId String
  action String
  change Json
  correlationId String?
  createdAt DateTime @default(now())
  @@index([requestId,createdAt])
}
model Document {
  id String @id @default(uuid())
  requestId String
  request CreditRequest @relation(fields:[requestId],references:[id])
  key String @unique
  name String
  mime String
  size Int
  createdAt DateTime @default(now())
}
model AnalysisEvent {
  id String @id @default(uuid())
  requestId String
  request CreditRequest @relation(fields:[requestId],references:[id])
  correlationId String
  dispatchedAt DateTime?
  processedAt DateTime?
  deadAt DateTime?
  attempts Int @default(0)
  replays Int @default(0)
  lastError String?
  createdAt DateTime @default(now())
  attemptsLog Attempt[]
  @@index([dispatchedAt,processedAt])
}
model Attempt {
  id String @id @default(uuid())
  eventId String
  event AnalysisEvent @relation(fields:[eventId],references:[id])
  number Int
  success Boolean
  error String?
  createdAt DateTime @default(now())
}
model Heartbeat {
  id String @id
  at DateTime @default(now())
}
